{
  "name": "nicoclient",
  "productName": "NicoClient",
  "version": "0.1.0",
  "private": true,
  "description": "NicoClient by Nicoweyin — an independent Minecraft launcher",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test scripts/modrinth-test.cjs scripts/launcher-test.cjs",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "dev.nicoweyin.nicoclient",
    "productName": "NicoClient",
    "publish": [{ "provider": "github", "owner": "Nicoweyin", "repo": "NicoClient" }],
    "generateUpdatesFilesForAllChannels": true,
    "directories": {
      "output": "release"
    },
    "extraResources": ["COPYRIGHT.md", "THIRD_PARTY_NOTICES.md", { "from": "fabric-mod/build/libs/nicoclient-fabric-0.1.0.jar", "to": "nicoclient-fabric-0.1.0.jar" }],
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "NicoClient-Setup-${version}.${ext}"
    },
    "nsis": {
      "createDesktopShortcut": false,
      "shortcutName": "NicoClient",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "scripts/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
