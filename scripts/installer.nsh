!macro customInstall
  SetShellVarContext current
  CreateDirectory "$APPDATA\NicoClient\mods"
  CreateDirectory "$APPDATA\NicoClient\config"
  CreateDirectory "$APPDATA\NicoClient\resourcepacks"
  CreateDirectory "$APPDATA\NicoClient\shaderpacks"
  CreateDirectory "$APPDATA\NicoClient\logs"
!macroend
